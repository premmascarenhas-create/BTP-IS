marily or I may be dismissed from the Service.By clicking “Agree”, I hereby certify that I have read and understood all of the clauses above and that I agree to all of them."></Property><Property Name="custDisclaimer2" Type="Edm.Boolean" Nullable="true" sap:required="true" sap:creatable="false" sap:updatable="false" sap:upsertable="false" sap:visible="true" sap:sortable="false" sap:filterable="false" sap:label="Agree"></Property><Property Name="custIdDocNum" Type="Edm.String" Nullable="true" sap:required="true" sap:creatable="false" sap:updatable="false" sap:upsertable="false" sap:visible="true" sap:sortable="true" sap:filterable="true" sap:label="Document ID"></Property><Property Name="custIdExpiryDate" Type="Edm.DateTimeOffset" Nullable="true" sap:required="false" sap:creatable="false" sap:updatable="false" sap:upsertable="false" sap:visible="true" sap:sortable="true" sap:filterable="true" sap:label="Expiry Date"></Property><Property Name="custIdIssueAuth" Type="Edm.String" Nullable="true" sap:required="false" sap:creatable="false" sap:updatable="false" sap:upsertable="false" sap:visible="true" sap:sortable="true" sap:filterable="true" sap:label="Issuing Authority"></Property><Property Name="custIdIssueDate" Type="Edm.DateTimeOffset" Nullable="true" sap:required="true" sap:creatable="false" sap:updatable="false" sap:upsertable="false" sap:visible="true" sap:sortable="true" sap:filterable="true" sap:label="Issue Date"></Property><Property Name="custIdIssuePlace" Type="Edm.String" Nullable="true" sap:required="false" sap:creatable="false" sap:updatable="false" sap:upsertable="false" sap:visible="true" sap:sortable="true" sap:filterable="true" sap:label="Place of Issue"></Property><Property Name="custIdValidated" Type="Edm.Boolean" Nullable="true" sap:required="false" sap:creatable="false" sap:updatable="false" sap:upsertable="false" sap:visible="true" sap:sortable="false" sap:filterable="false" sap:label="Verified as Valid?"></Property><Property Name="custInstrAckno