></Documentation></EntitySet><EntitySet Name="Benefit" EntityType="SFOData.Benefit" sap:label="Benefit" sap:creatable="false" sap:updatable="false" sap:upsertable="false" sap:deletable="false"><Documentation><Summary>Benefit</Summary><LongDescription>This entity is used to create and configure benefits. It is used for reimbursements and allowances, such as medical bills, higher education, and a company car.</LongDescription><sap:tagcollection><sap:tag>Employee Central (EC)</sap:tag><sap:tag>EC - Global Benefits</sap:tag></sap:tagcollection></Documentation></EntitySet><EntitySet Name="JobReqFOLocation" EntityType="SFOData.JobReqFOLocation" sap:label="JobReqFOLocation" sap:creatable="false" sap:updatable="false" sap:upsertable="false" sap:deletable="false"><Documentation><Summary>Job Req FOLocation Object</Summary><LongDescription>This Entity represents the job requisition FO Location object field</LongDescription><sap:tagcollection><sap:tag>Recruiting (RCM)</sap:tag><sap:tag>RCM - Job Requisition</sap:tag></sap:tagcollection></Documentation></EntitySet><EntitySet Name="TimeAccountPurchaseProfilePayComponentAssignment" EntityType="SFOData.TimeAccountPurchaseProfilePayComponentAssignment" sap:label="TimeAccountPurchaseProfilePayComponentAssignment" sap:creatable="false" sap:updatable="false" sap:upsertable="false" sap:deletable="false"><Documentation><Summary>TimeAccountPurchaseProfilePayComponentAssignment</Summary><LongDescription>Wrapper for Paycomponents. Hold deduction type paycomponents for Purchase leave</LongDescription><sap:tagcollection><sap:tag>Employee Central (EC)</sap:tag><sap:tag>EC - Time Off</sap:tag></sap:tagcollection></Documentation></EntitySet><EntitySet Name="FormReviewFeedback" EntityType="SFOData.FormReviewFeedback" sap:label="FormReviewFeedback" sap:creatable="false" sap:updatable="false" sap:upsertable="false" sap:deletable="false"><Documentation><Summary>FormReviewFeedback</Summary><LongDescription>It contains review feedback for a form</Long