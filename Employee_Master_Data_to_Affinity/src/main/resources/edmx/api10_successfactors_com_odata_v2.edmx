ata.JobApplicationOnboardingData" sap:label="JobApplicationOnboardingData" sap:creatable="false" sap:updatable="false" sap:upsertable="false" sap:deletable="false"><Documentation><Summary>JobApplicationOnboardingData</Summary><LongDescription>The JobApplicationOnboardingData represents the Onboarding portlet of a job application.</LongDescription><sap:tagcollection><sap:tag>Recruiting (RCM)</sap:tag><sap:tag>RCM - Job Application</sap:tag></sap:tagcollection></Documentation></EntitySet><EntitySet Name="FOJobClassLocalITA" EntityType="SFOData.FOJobClassLocalITA" sap:label="Job Code Italy" sap:creatable="false" sap:updatable="false" sap:upsertable="false" sap:deletable="false"><Documentation><Summary>FOJobClassLocalITA</Summary><LongDescription>This is a foundation object that contains country-specific job class for ITA.</LongDescription><sap:tagcollection><sap:tag>Employee Central (EC)</sap:tag><sap:tag>EC - Foundation/Organization</sap:tag></sap:tagcollection></Documentation></EntitySet><EntitySet Name="PensionBandingConfiguration" EntityType="SFOData.PensionBandingConfiguration" sap:label="Bands Based on Pensionable Earnings" sap:creatable="false" sap:updatable="false" sap:upsertable="false" sap:deletable="false"><Documentation><Summary>PensionBandingConfiguration</Summary><LongDescription>This entity contains the Pension Banding Configuration Details which contains banding applicable for contribution.</LongDescription><sap:tagcollection><sap:tag>Employee Central (EC)</sap:tag><sap:tag>EC - Global Benefits</sap:tag></sap:tagcollection></Documentation></EntitySet><EntitySet Name="NavigationGroup" EntityType="SFOData.NavigationGroup" sap:label="Navigation Group" sap:creatable="false" sap:updatable="false" sap:upsertable="false" sap:deletable="false"><Documentation><Summary></Summary><LongDescription></LongDescription><sap:tagcollection><sap:tag>Employee Central (EC)</sap:tag><sap:tag>UI Configuration</sap:tag></sap:tagcollection></Documentation></EntitySet><EntitySet Name="JobProfile" EntityType="SFOData.JobProfile" sap:label="Job Profile" sap:creatable="true" sap:updatable="true" sap:upsertable="true" sap:deletable="true"><Documentation><Summary>JobProfile</Summary><LongDescription>Contains detailed profiling information of a job. It inherits all of the competency and skill information from a job role and describes additional job information, such as education, certification, and physical requirements.</LongDescription><sap:tagcollection><sap:tag>Suite (STE)</sap:tag><sap:tag>STE - Skills Management</sap:tag></sap:tagcollection></Documentation></EntitySet><EntitySet Name="JobApplicationStatusAuditTrail" EntityType="SFOData.JobApplicationStatusAuditTrail" sap:label="JobApplicationStatusAuditTrail" sap:creatable="false" sap:updatable="false" sap:upsertable="false" sap:deletable="false"><Documentation><Summary>JobApplicationStatusAuditTrail</Summary><LongDescription>The JobApplication Audit trail represents the Audit trail information of a job application.</LongDescription><sap:tagcollection><sap:tag>Recruiting (RCM)</sap:tag><sap:tag>RCM - Job Application</sap:tag></sap:tagcollection></Documentation></EntitySet><EntitySet Name="FOCostCenter" EntityType="SFOData.FOCostCenter" sap:label="Cost Center" sap:creatable="true" sap:updatable="true" sap:upsertable="true" sap:deletable="true"><Documentation><Summary>FOCostCenter</Summary><LongDescription>This is a foundation object that describes a cost center.</LongDescription><sap:tagcollection><sap:tag>Employee Central (EC)</sap:tag><sap:tag>EC - Foundation/Organization</sap:tag><sap:tag>Recommended</sap:tag></sap:tagcollection></Documentation></EntitySet><EntitySet Name="PicklistOption" EntityType="SFOData.PicklistOption" sap:label="PicklistOption" sap:creatable="true" sap:updatable="true" sap:upsertable="false" sap:deletable="false"><Documentation><Summary>PicklistOption</Summary><LongDescription>Contains information related to pick list options.</LongDescription><sap:tagcollection><s